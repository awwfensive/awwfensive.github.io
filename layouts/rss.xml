{{- $pages := where site.RegularPages "Params.indexed" true -}}
{{- if eq .Section "notes" -}}{{- $pages = where $pages "Params.content_type" "note" -}}{{- end -}}
{{- if eq .Section "blog" -}}{{- $pages = where .RegularPages "Params.content_type" "ne" "note" -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} | {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $pages.ByDate.Reverse }}
    <item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Params.summary | default .Description | default (.Summary | plainify) }}</description></item>
    {{ end }}
  </channel>
</rss>
